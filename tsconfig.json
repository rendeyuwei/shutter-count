{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "shared/**/*.ts",
    "web/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "bin/**/*.ts",
    "tools/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "test/fixtures"]
}
