{
  "name": "shutter-count",
  "version": "1.0.0",
  "description": "Upload a camera-original JPEG and read its shutter count (EXIF + MakerNotes via ExifTool).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node dist/src/main.js",
    "build": "tsx tools/build.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "npm run build && npm run test:built",
    "test:built": "node --test dist/test/*.test.js",
    "dev:server": "tsx watch src/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"shared/**/*.ts\" \"web/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"bin/**/*.ts\" \"tools/**/*.ts\" vite.config.ts tsconfig*.json .prettierrc.json docs/MODERNIZATION*.md",
    "smoke": "node dist/scripts/smoke.js",
    "build:trusted": "tsx tools/build-trusted.ts",
    "test:browser": "node --test dist/test/browser/*.test.js",
    "test:production": "node dist/tools/verify-production.js"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.6",
    "exiftool-vendored": "^39.0.1",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
